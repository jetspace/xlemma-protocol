{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/dependency-dividend.schema.json",
  "title": "DependencyDividend",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dividend_id": { "type": "string", "pattern": "^xldividend:blake3:[0-9a-f]{64}$" },
    "revenue_event_id": { "type": "string", "pattern": "^xlrevenue:blake3:[0-9a-f]{64}$" },
    "downstream_claim_id": { "type": "string", "pattern": "^xlc:blake3:[0-9a-f]{64}$" },
    "upstream_claim_id": { "type": "string", "pattern": "^xlc:blake3:[0-9a-f]{64}$" },
    "used_in_final_proof": { "const": true },
    "final_dependency_root": { "$ref": "common.schema.json#/$defs/hash" },
    "compute_savings_evidence_root": { "$ref": "common.schema.json#/$defs/hash" },
    "downstream_net_revenue": { "$ref": "common.schema.json#/$defs/amount" },
    "payout": { "$ref": "common.schema.json#/$defs/amount" },
    "cap_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "finalized_at": { "type": "string", "format": "date-time" },
    "signature": { "$ref": "common.schema.json#/$defs/signature" }
  },
  "required": [
    "dividend_id", "revenue_event_id", "downstream_claim_id", "upstream_claim_id",
    "used_in_final_proof", "final_dependency_root", "compute_savings_evidence_root",
    "downstream_net_revenue", "payout", "cap_bps", "finalized_at", "signature"
  ]
}
