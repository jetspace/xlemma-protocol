{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/credential-status-proof.schema.json",
  "title": "CredentialStatusProof",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "user_credential_id": { "$ref": "identity-common.schema.json#/$defs/userCredentialId" },
    "operator_credential_id": { "$ref": "identity-common.schema.json#/$defs/operatorCredentialId" },
    "node_credential_id": { "$ref": "identity-common.schema.json#/$defs/nodeCredentialId" },
    "revocation_registry_root": { "$ref": "common.schema.json#/$defs/hash" },
    "checked_at": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "non_revocation_proof": { "type": "string", "minLength": 1 },
    "issuer_signature": { "$ref": "common.schema.json#/$defs/signature" }
  },
  "required": [
    "user_credential_id", "operator_credential_id", "node_credential_id",
    "revocation_registry_root", "checked_at", "valid_until", "non_revocation_proof",
    "issuer_signature"
  ]
}
