{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/eligible-node.schema.json",
  "title": "EligibleNode",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "node_id": { "$ref": "node-network-common.schema.json#/$defs/nodeId" },
    "operator_id": { "$ref": "node-network-common.schema.json#/$defs/operatorId" },
    "operator_cluster_id": { "$ref": "node-network-common.schema.json#/$defs/operatorClusterId" },
    "credential_chain": { "$ref": "node-credential-chain.schema.json" },
    "advertisement_id": { "$ref": "node-network-common.schema.json#/$defs/advertisementId" },
    "roles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "node-network-common.schema.json#/$defs/nodeRole" }
    },
    "checker_families": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "node-network-common.schema.json#/$defs/checkerFamily" }
    },
    "bond_id": { "$ref": "node-network-common.schema.json#/$defs/bondId" },
    "active_bond": { "$ref": "common.schema.json#/$defs/amount" },
    "reputation_snapshot_id": { "$ref": "node-network-common.schema.json#/$defs/reputationId" },
    "reputation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formal_accuracy": { "$ref": "node-network-common.schema.json#/$defs/reputationMetric" },
        "availability": { "$ref": "node-network-common.schema.json#/$defs/reputationMetric" },
        "latency": { "$ref": "node-network-common.schema.json#/$defs/reputationMetric" },
        "novelty_calibration": { "$ref": "node-network-common.schema.json#/$defs/reputationMetric" },
        "challenge_quality": { "$ref": "node-network-common.schema.json#/$defs/reputationMetric" },
        "independence": { "$ref": "node-network-common.schema.json#/$defs/reputationMetric" },
        "storage_quality": { "$ref": "node-network-common.schema.json#/$defs/reputationMetric" },
        "integrity": { "$ref": "node-network-common.schema.json#/$defs/reputationMetric" }
      },
      "required": [
        "formal_accuracy", "availability", "latency", "novelty_calibration",
        "challenge_quality", "independence", "storage_quality", "integrity"
      ]
    },
    "infrastructure_provider": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "minLength": 1 },
    "active": { "type": "boolean" }
  },
  "required": [
    "node_id", "operator_id", "operator_cluster_id", "credential_chain", "advertisement_id", "roles",
    "checker_families", "bond_id", "active_bond", "reputation_snapshot_id",
    "reputation", "infrastructure_provider", "region", "active"
  ]
}
