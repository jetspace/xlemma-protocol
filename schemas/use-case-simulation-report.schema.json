{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/use-case-simulation-report.schema.json",
  "title": "UseCaseSimulationReport",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "const": "XLMP/1" },
    "report_version": { "const": "xlemma-use-case-simulation-v2" },
    "generated_at": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario_count": { "type": "integer", "minimum": 1 },
        "passed_scenarios": { "type": "integer", "minimum": 0 },
        "failed_scenarios": { "type": "integer", "minimum": 0 },
        "gate_count": { "type": "integer", "minimum": 1 },
        "passed_gates": { "type": "integer", "minimum": 0 },
        "failed_gates": { "type": "integer", "minimum": 0 },
        "rust_test_count": { "type": "integer", "minimum": 1 }
      },
      "required": ["scenario_count", "passed_scenarios", "failed_scenarios", "gate_count", "passed_gates", "failed_gates", "rust_test_count"]
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail"] },
          "command": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "error": { "type": ["string", "null"] }
        },
        "required": ["id", "title", "status", "command", "evidence", "error"]
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^UC-[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail"] },
          "protocol_path": { "type": "string", "minLength": 1 },
          "positive_outcome": { "type": "string", "minLength": 1 },
          "negative_invariant": { "type": "string", "minLength": 1 },
          "gates": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "required_tests": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "missing_tests": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "trace": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sequence": { "type": "integer", "minimum": 1 },
                "step": { "type": "string", "minLength": 1 },
                "status": { "enum": ["pass", "fail"] }
              },
              "required": ["sequence", "step", "status"]
            }
          }
        },
        "required": ["id", "title", "status", "protocol_path", "positive_outcome", "negative_invariant", "gates", "required_tests", "missing_tests", "trace"]
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": ["protocol_version", "report_version", "generated_at", "summary", "gates", "scenarios", "limitations"]
}
