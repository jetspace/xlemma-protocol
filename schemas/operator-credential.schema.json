{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/operator-credential.schema.json",
  "title": "XLMP_OperatorCredential",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "credential_id": { "$ref": "identity-common.schema.json#/$defs/operatorCredentialId" },
    "operator_id": { "$ref": "identity-common.schema.json#/$defs/operatorId" },
    "verified_user_id": { "$ref": "identity-common.schema.json#/$defs/verifiedUserId" },
    "user_credential_id": { "$ref": "identity-common.schema.json#/$defs/userCredentialId" },
    "operator_cluster_id": { "$ref": "node-network-common.schema.json#/$defs/operatorClusterId" },
    "authorized_roles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "node-network-common.schema.json#/$defs/nodeRole" }
    },
    "qualifications": {
      "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }
    },
    "jurisdiction_class": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "evidence_root": { "$ref": "common.schema.json#/$defs/hash" },
    "holder_delegation_signature": { "$ref": "common.schema.json#/$defs/signature" },
    "issuer_signature": { "$ref": "common.schema.json#/$defs/signature" }
  },
  "required": [
    "credential_id", "operator_id", "verified_user_id", "user_credential_id",
    "operator_cluster_id", "authorized_roles", "qualifications", "jurisdiction_class",
    "issued_at", "expires_at", "evidence_root", "holder_delegation_signature",
    "issuer_signature"
  ]
}
