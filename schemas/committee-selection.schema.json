{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/committee-selection.schema.json",
  "title": "CommitteeSelection",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sortition_id": { "$ref": "node-network-common.schema.json#/$defs/sortitionId" },
    "job_id": { "$ref": "node-network-common.schema.json#/$defs/jobId" },
    "policy_id": { "$ref": "node-network-common.schema.json#/$defs/policyId" },
    "randomness_commitment": { "$ref": "common.schema.json#/$defs/hash" },
    "eligible_set_root": { "$ref": "common.schema.json#/$defs/hash" },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": { "$ref": "node-network-common.schema.json#/$defs/nodeRole" },
          "slot": { "type": "integer", "minimum": 0 },
          "node_id": { "$ref": "node-network-common.schema.json#/$defs/nodeId" },
          "operator_cluster_id": { "$ref": "node-network-common.schema.json#/$defs/operatorId" },
          "advertisement_id": { "$ref": "node-network-common.schema.json#/$defs/advertisementId" },
          "bond_id": { "$ref": "node-network-common.schema.json#/$defs/bondId" },
          "reputation_snapshot_id": { "$ref": "node-network-common.schema.json#/$defs/reputationId" },
          "infrastructure_provider": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 1 },
          "rank_hash": { "$ref": "common.schema.json#/$defs/hash" }
        },
        "required": [
          "role", "slot", "node_id", "operator_cluster_id", "advertisement_id", "bond_id",
          "reputation_snapshot_id", "infrastructure_provider", "region", "rank_hash"
        ]
      }
    },
    "selection_root": { "$ref": "common.schema.json#/$defs/hash" },
    "selected_at": { "type": "string", "format": "date-time" }
  },
  "required": [
    "sortition_id", "job_id", "policy_id", "randomness_commitment", "eligible_set_root",
    "members", "selection_root", "selected_at"
  ]
}
