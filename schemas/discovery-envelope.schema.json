{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/discovery-envelope.schema.json",
  "title": "Signed replay-protected discovery envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "type": "string",
      "pattern": "^xlr:blake3:[0-9a-f]{64}$"
    },
    "trust_root": {
      "type": "string",
      "pattern": "^xlpolicy:blake3:[0-9a-f]{64}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "signer": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"
    },
    "command": {
      "$ref": "discovery-command.schema.json"
    },
    "signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "command_id",
    "trust_root",
    "nonce",
    "issued_at",
    "expires_at",
    "signer",
    "command",
    "signature"
  ]
}
