{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/wallet-intent.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "XLMP/1"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^xlpolicy:blake3:[0-9a-f]{64}$"
    },
    "trust_root": {
      "type": "string",
      "pattern": "^xlpolicy:blake3:[0-9a-f]{64}$"
    },
    "principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "wallet_address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "nonce": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "valid_after": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "valid_until": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maximum_fee_units": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fund_round"
            },
            "round_id": {
              "type": "string",
              "pattern": "^xlround:blake3:[0-9a-f]{64}$"
            },
            "category": {
              "enum": [
                "foundational_research",
                "discovery",
                "formalization",
                "proof_improvement",
                "replication",
                "research_tools",
                "negative_result"
              ]
            },
            "amount_units": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "mandate_root": {
              "type": "string",
              "pattern": "^xla:blake3:[0-9a-f]{64}$"
            }
          },
          "required": [
            "kind",
            "round_id",
            "category",
            "amount_units",
            "mandate_root"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "refund"
            },
            "round_id": {
              "type": "string",
              "pattern": "^xlround:blake3:[0-9a-f]{64}$"
            },
            "category": {
              "enum": [
                "foundational_research",
                "discovery",
                "formalization",
                "proof_improvement",
                "replication",
                "research_tools",
                "negative_result"
              ]
            }
          },
          "required": [
            "kind",
            "round_id",
            "category"
          ]
        }
      ]
    }
  },
  "required": [
    "protocol_version",
    "policy_id",
    "trust_root",
    "principal",
    "wallet_address",
    "nonce",
    "valid_after",
    "valid_until",
    "maximum_fee_units",
    "action"
  ]
}
