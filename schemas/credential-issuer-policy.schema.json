{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/credential-issuer-policy.schema.json",
  "title": "CredentialIssuerPolicy",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "claim": { "type": "string", "enum": ["uniqueness", "organization", "operator_eligibility", "role_qualification", "conflict_clearance", "non_revocation"] }
  },
  "properties": {
    "policy_id": { "type": "string", "pattern": "^xlpolicy:blake3:[0-9a-f]{64}$" },
    "approved_issuers": {
      "type": "object", "minProperties": 2,
      "additionalProperties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/claim" } }
    },
    "requirements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "any_of": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/claim" } },
          "minimum_distinct_issuers": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "required": ["any_of", "minimum_distinct_issuers"]
      }
    },
    "minimum_distinct_issuers": { "type": "integer", "minimum": 2, "maximum": 65535 },
    "maximum_issuer_attestation_share_bps": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "revocation_transparency_roots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/hash" } },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "signatures": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/signature" } }
  },
  "required": ["policy_id", "approved_issuers", "requirements", "minimum_distinct_issuers", "maximum_issuer_attestation_share_bps", "revocation_transparency_roots", "valid_from", "valid_until", "signatures"]
}
