{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/service-match.schema.json",
  "title": "ServiceMatch",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "match_id": { "$ref": "node-network-common.schema.json#/$defs/matchId" },
    "order_id": { "$ref": "node-network-common.schema.json#/$defs/orderId" },
    "advertisement_id": { "$ref": "node-network-common.schema.json#/$defs/advertisementId" },
    "advertisement_sequence": { "type": "integer", "minimum": 1 },
    "node_id": { "$ref": "node-network-common.schema.json#/$defs/nodeId" },
    "operator_id": { "$ref": "node-network-common.schema.json#/$defs/operatorId" },
    "operator_cluster_id": { "$ref": "node-network-common.schema.json#/$defs/operatorClusterId" },
    "service": { "$ref": "node-network-common.schema.json#/$defs/serviceKind" },
    "reserved_units": { "type": "integer", "minimum": 1 },
    "agreed_price": { "$ref": "common.schema.json#/$defs/amount" },
    "scheduled_start": { "type": "string", "format": "date-time" },
    "scheduled_end": { "type": "string", "format": "date-time" },
    "matched_at": { "type": "string", "format": "date-time" },
    "signature": { "$ref": "common.schema.json#/$defs/signature" }
  },
  "required": [
    "match_id", "order_id", "advertisement_id", "advertisement_sequence", "node_id", "operator_id",
    "operator_cluster_id", "service", "reserved_units", "agreed_price", "scheduled_start",
    "scheduled_end", "matched_at", "signature"
  ]
}
