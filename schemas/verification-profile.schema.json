{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/verification-profile.schema.json",
  "title": "VerificationProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "policy_id": { "type": "string", "pattern": "^xlpolicy:blake3:[0-9a-f]{64}$" },
    "class": { "type": "string", "enum": ["formal", "computational", "statistical", "simulation", "empirical", "hybrid"] },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["formal_statement", "proof_object", "pinned_toolchain", "axiom_inventory", "reproducible_source", "execution_environment", "dependency_lock", "deterministic_rerun", "dataset_provenance", "analysis_plan", "uncertainty_report", "robustness_checks", "model_definition", "random_seeds", "parameter_ranges", "convergence_analysis", "sensitivity_analysis", "protocol_registration", "instrument_manifest", "data_lineage", "independent_replication"]
      }
    },
    "verifier_implementations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "minimum_reproductions": { "type": "integer", "minimum": 2, "maximum": 65535 },
    "minimum_independent_operators": { "type": "integer", "minimum": 2, "maximum": 65535 },
    "challenge_window_seconds": { "type": "integer", "minimum": 1 },
    "policy_root": { "$ref": "common.schema.json#/$defs/hash" }
  },
  "required": ["policy_id", "class", "required_evidence", "verifier_implementations", "minimum_reproductions", "minimum_independent_operators", "challenge_window_seconds", "policy_root"]
}
