{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/economic-constitution.schema.json",
  "title": "EconomicConstitution",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "policy_id": { "type": "string", "pattern": "^xlpolicy:blake3:[0-9a-f]{64}$" },
    "mode": { "type": "string", "enum": ["commons", "reciprocal", "commercial_artifact", "sponsored_challenge"] },
    "qualifying_revenue_sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "upstream_pool_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "per_ancestor_cap_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "max_ancestors": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "max_dependency_depth": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "depth_decay_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "minimum_payout_units": { "type": "integer", "minimum": 0 },
    "bare_citations_eligible": { "const": false },
    "externally_independent_claims_eligible": { "const": false },
    "downstream_veto": { "const": false },
    "recursive_charging": { "const": false },
    "single_charge_per_revenue_event": { "const": true },
    "equivalent_claim_clustering": { "const": true },
    "policy_root": { "$ref": "common.schema.json#/$defs/hash" },
    "signatures": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/signature" } }
  },
  "required": ["policy_id", "mode", "qualifying_revenue_sources", "upstream_pool_bps", "per_ancestor_cap_bps", "max_ancestors", "max_dependency_depth", "depth_decay_bps", "minimum_payout_units", "bare_citations_eligible", "externally_independent_claims_eligible", "downstream_veto", "recursive_charging", "single_charge_per_revenue_event", "equivalent_claim_clustering", "policy_root", "signatures"]
}
