{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AvailabilityReceipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^xlr:blake3:[0-9a-f]{64}$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^xla:blake3:[0-9a-f]{64}$"
    },
    "storage_node_id": {
      "type": "string",
      "pattern": "^xlnode:blake3:[0-9a-f]{64}$"
    },
    "operator_cluster_id": {
      "type": "string",
      "pattern": "^xloperator:blake3:[0-9a-f]{64}$"
    },
    "provider": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "custody_challenge_root": {
      "type": "string",
      "minLength": 16,
      "maxLength": 512
    },
    "available_until": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "artifact_id",
    "storage_node_id",
    "operator_cluster_id",
    "provider",
    "region",
    "custody_challenge_root",
    "available_until",
    "observed_at",
    "signature"
  ],
  "$id": "https://xlemma.example/schemas/availability.schema.json"
}
