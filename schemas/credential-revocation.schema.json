{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/credential-revocation.schema.json",
  "title": "XLMP_CredentialRevocation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "revocation_id": { "$ref": "identity-common.schema.json#/$defs/credentialRevocationId" },
    "credential": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "credential_kind": { "const": "user" },
            "credential_id": { "$ref": "identity-common.schema.json#/$defs/userCredentialId" }
          },
          "required": ["credential_kind", "credential_id"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "credential_kind": { "const": "operator" },
            "credential_id": { "$ref": "identity-common.schema.json#/$defs/operatorCredentialId" }
          },
          "required": ["credential_kind", "credential_id"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "credential_kind": { "const": "node" },
            "credential_id": { "$ref": "identity-common.schema.json#/$defs/nodeCredentialId" }
          },
          "required": ["credential_kind", "credential_id"]
        }
      ]
    },
    "effective_at": { "type": "string", "format": "date-time" },
    "reason_code": { "type": "string", "minLength": 1 },
    "evidence_root": { "$ref": "common.schema.json#/$defs/hash" },
    "issuer": { "type": "string", "minLength": 1 },
    "issuer_signature": { "$ref": "common.schema.json#/$defs/signature" }
  },
  "required": [
    "revocation_id", "credential", "effective_at", "reason_code", "evidence_root",
    "issuer", "issuer_signature"
  ]
}
