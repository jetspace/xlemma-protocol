{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/research-compute-cooperative.schema.json",
  "title": "ResearchComputeCooperative",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cooperative_id": { "type": "string", "pattern": "^xlcoop:blake3:[0-9a-f]{64}$" },
    "members": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": { "pattern": "^xluser:blake3:[0-9a-f]{64}$" },
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 10000 }
    },
    "operator_cluster_id": { "type": "string", "pattern": "^xloperator:blake3:[0-9a-f]{64}$" },
    "node_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^xlnode:blake3:[0-9a-f]{64}$" } },
    "capability_classes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "shared_treasury": { "type": "string", "minLength": 1 },
    "governance_policy_id": { "type": "string", "pattern": "^xlpolicy:blake3:[0-9a-f]{64}$" },
    "beneficial_control_evidence_root": { "$ref": "common.schema.json#/$defs/hash" },
    "created_at": { "type": "string", "format": "date-time" },
    "supersedes": { "type": ["string", "null"], "pattern": "^xlcoop:blake3:[0-9a-f]{64}$" },
    "signatures": { "type": "array", "minItems": 2, "items": { "$ref": "common.schema.json#/$defs/signature" } }
  },
  "required": ["cooperative_id", "members", "operator_cluster_id", "node_ids", "capability_classes", "shared_treasury", "governance_policy_id", "beneficial_control_evidence_root", "created_at", "signatures"],
  "$comment": "Member shares MUST total 10,000 bps; protocol logic enforces the sum. The cooperative is one operator-independence cluster."
}
