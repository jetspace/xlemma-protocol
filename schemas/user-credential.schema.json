{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/user-credential.schema.json",
  "title": "XLMP_UserCredential",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "credential_id": { "$ref": "identity-common.schema.json#/$defs/userCredentialId" },
    "verified_user_id": { "$ref": "identity-common.schema.json#/$defs/verifiedUserId" },
    "researcher_id": {
      "anyOf": [
        { "type": "string", "pattern": "^xlresearcher:blake3:[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "public_subject": { "type": "string", "minLength": 1 },
    "tier": { "$ref": "identity-common.schema.json#/$defs/credentialTier" },
    "issuer": { "type": "string", "minLength": 1 },
    "uniqueness_commitment": { "type": "string", "minLength": 1 },
    "qualifications": {
      "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }
    },
    "disclosure_policy": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "evidence_root": { "$ref": "common.schema.json#/$defs/hash" },
    "issuer_signature": { "$ref": "common.schema.json#/$defs/signature" }
  },
  "required": [
    "credential_id", "verified_user_id", "researcher_id", "public_subject", "tier",
    "issuer", "uniqueness_commitment", "qualifications", "disclosure_policy",
    "issued_at", "expires_at", "evidence_root", "issuer_signature"
  ]
}
