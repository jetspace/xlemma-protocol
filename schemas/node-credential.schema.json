{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/node-credential.schema.json",
  "title": "XLMP_NodeCredential",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "credential_id": { "$ref": "identity-common.schema.json#/$defs/nodeCredentialId" },
    "node_id": { "$ref": "node-network-common.schema.json#/$defs/nodeId" },
    "operator_id": { "$ref": "identity-common.schema.json#/$defs/operatorId" },
    "operator_credential_id": { "$ref": "identity-common.schema.json#/$defs/operatorCredentialId" },
    "operator_cluster_id": { "$ref": "node-network-common.schema.json#/$defs/operatorClusterId" },
    "node_public_key": { "type": "string", "minLength": 1 },
    "authorized_roles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "node-network-common.schema.json#/$defs/nodeRole" }
    },
    "hardware_attestation_root": {
      "anyOf": [{ "$ref": "common.schema.json#/$defs/hash" }, { "type": "null" }]
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "evidence_root": { "$ref": "common.schema.json#/$defs/hash" },
    "operator_delegation_signature": { "$ref": "common.schema.json#/$defs/signature" }
  },
  "required": [
    "credential_id", "node_id", "operator_id", "operator_credential_id",
    "operator_cluster_id", "node_public_key", "authorized_roles",
    "hardware_attestation_root", "issued_at", "expires_at", "evidence_root",
    "operator_delegation_signature"
  ]
}
