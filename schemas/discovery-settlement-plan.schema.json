{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/discovery-settlement-plan.schema.json",
  "title": "Immutable funded discovery settlement proposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^xlr:blake3:[0-9a-f]{64}$"
    },
    "round_id": {
      "type": "string",
      "pattern": "^xlround:blake3:[0-9a-f]{64}$"
    },
    "chain_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "escrow_address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "usdc_asset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "completed_review": {
            "type": "boolean"
          },
          "work_root": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "category": {
            "enum": [
              "foundational_research",
              "discovery",
              "formalization",
              "proof_improvement",
              "replication",
              "research_tools",
              "negative_result"
            ]
          },
          "recipient": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "amount_units": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "certificate_digest": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "claim_digest": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "policy_digest": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          }
        },
        "required": [
          "completed_review",
          "work_root",
          "category",
          "recipient",
          "amount_units",
          "certificate_digest",
          "claim_digest",
          "artifact_digest",
          "policy_digest"
        ]
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "total_units": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "allocation_evidence_root": {
      "type": "string",
      "pattern": "^xlr:blake3:[0-9a-f]{64}$"
    }
  },
  "required": [
    "plan_id",
    "round_id",
    "chain_id",
    "escrow_address",
    "usdc_asset",
    "items",
    "total_units",
    "allocation_evidence_root"
  ]
}
