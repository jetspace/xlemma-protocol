{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/xlmp-envelope.schema.json",
  "title": "XLMP/1 Envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": { "const": "XLMP" },
    "version": { "const": 1 },
    "message_id": { "$ref": "#/$defs/messageId" },
    "correlation_id": {
      "anyOf": [{ "$ref": "#/$defs/messageId" }, { "type": "null" }]
    },
    "sender": { "type": "string", "minLength": 1 },
    "sent_at": { "type": "string", "format": "date-time" },
    "message": {
      "oneOf": [
        { "$ref": "#/$defs/claimMessage" },
        { "$ref": "#/$defs/commitMessage" },
        { "$ref": "#/$defs/computeQuoteMessage" },
        { "$ref": "#/$defs/proofCandidateMessage" },
        { "$ref": "#/$defs/verifyRequestMessage" },
        { "$ref": "#/$defs/observationCommitMessage" },
        { "$ref": "#/$defs/observationRevealMessage" },
        { "$ref": "#/$defs/certificateMessage" },
        { "$ref": "#/$defs/challengeMessage" },
        { "$ref": "#/$defs/finalizeMessage" },
        { "$ref": "#/$defs/revenueMessage" },
        { "$ref": "#/$defs/revalidateMessage" },
        { "$ref": "#/$defs/nodeAdvertiseMessage" },
        { "$ref": "#/$defs/discoveryRequestMessage" },
        { "$ref": "#/$defs/discoveryResponseMessage" },
        { "$ref": "#/$defs/serviceOrderMessage" },
        { "$ref": "#/$defs/serviceMatchMessage" },
        { "$ref": "#/$defs/sortitionRequestMessage" },
        { "$ref": "#/$defs/committeeMessage" },
        { "$ref": "#/$defs/reputationMessage" },
        { "$ref": "#/$defs/bondMessage" },
        { "$ref": "#/$defs/userCredentialMessage" },
        { "$ref": "#/$defs/operatorCredentialMessage" },
        { "$ref": "#/$defs/nodeCredentialMessage" },
        { "$ref": "#/$defs/credentialRevocationMessage" },
        { "$ref": "#/$defs/sovereigntyMessage" },
        { "$ref": "#/$defs/portabilityMessage" },
        { "$ref": "#/$defs/residualRightMessage" },
        { "$ref": "#/$defs/economicConstitutionMessage" },
        { "$ref": "#/$defs/economicComplianceMessage" },
        { "$ref": "#/$defs/verificationProfileMessage" },
        { "$ref": "#/$defs/reproductionObservationMessage" },
        { "$ref": "#/$defs/researchCertificateMessage" },
        { "$ref": "#/$defs/computeCooperativeMessage" },
        { "$ref": "#/$defs/captureDashboardMessage" },
        { "$ref": "#/$defs/nodeWorkMessage" },
        { "$ref": "#/$defs/nodeExposureMessage" },
        { "$ref": "#/$defs/misconductMessage" },
        { "$ref": "#/$defs/governanceProposalMessage" },
        { "$ref": "#/$defs/credentialEvidenceMessage" }
      ]
    },
    "signature": { "$ref": "common.schema.json#/$defs/signature" }
  },
  "required": ["protocol", "version", "message_id", "correlation_id", "sender", "sent_at", "message", "signature"],
  "$defs": {
    "messageId": { "type": "string", "pattern": "^xlmessage:blake3:[0-9a-f]{64}$" },
    "jobId": { "type": "string", "pattern": "^xljob:blake3:[0-9a-f]{64}$" },
    "claimId": { "type": "string", "pattern": "^xlc:blake3:[0-9a-f]{64}$" },
    "proofId": { "type": "string", "pattern": "^xlp:blake3:[0-9a-f]{64}$" },
    "artifactId": { "type": "string", "pattern": "^xla:blake3:[0-9a-f]{64}$" },
    "policyId": { "type": "string", "pattern": "^xlpolicy:blake3:[0-9a-f]{64}$" },
    "receiptId": { "type": "string", "pattern": "^xlr:blake3:[0-9a-f]{64}$" },
    "certificateId": { "type": "string", "pattern": "^xlcert:blake3:[0-9a-f]{64}$" },
    "claimPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_id": { "$ref": "#/$defs/claimId" },
        "claim": { "$ref": "claim.schema.json" },
        "contribution_manifest_hash": { "$ref": "common.schema.json#/$defs/hash" },
        "rights_manifest_hash": { "$ref": "common.schema.json#/$defs/hash" }
      },
      "required": ["claim_id", "claim", "contribution_manifest_hash", "rights_manifest_hash"]
    },
    "commitPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": { "$ref": "#/$defs/jobId" },
        "researcher_id": { "type": "string", "pattern": "^xlresearcher:blake3:[0-9a-f]{64}$" },
        "claim_id": { "$ref": "#/$defs/claimId" },
        "commitment_root": { "$ref": "common.schema.json#/$defs/hash" },
        "verification_policy_id": { "$ref": "#/$defs/policyId" },
        "reveal_deadline": { "type": "string", "format": "date-time" }
      },
      "required": ["job_id", "researcher_id", "claim_id", "commitment_root", "verification_policy_id", "reveal_deadline"]
    },
    "proofCandidatePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": { "$ref": "#/$defs/jobId" },
        "proof_id": { "$ref": "#/$defs/proofId" },
        "proof": { "$ref": "proof.schema.json" },
        "artifact_id": { "$ref": "#/$defs/artifactId" }
      },
      "required": ["job_id", "proof_id", "proof", "artifact_id"]
    },
    "verifyRequestPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job": { "$ref": "verification-job.schema.json" },
        "exact_challenge_hash": { "$ref": "common.schema.json#/$defs/hash" },
        "dependency_root": { "$ref": "common.schema.json#/$defs/hash" },
        "axiom_policy_id": { "$ref": "#/$defs/policyId" }
      },
      "required": ["job", "exact_challenge_hash", "dependency_root", "axiom_policy_id"]
    },
    "observationCommitPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": { "$ref": "#/$defs/jobId" },
        "receipt_id": { "$ref": "#/$defs/receiptId" },
        "node_id": { "type": "string", "pattern": "^xlnode:blake3:[0-9a-f]{64}$" },
        "verified_user_id": { "$ref": "identity-common.schema.json#/$defs/verifiedUserId" },
        "operator_id": { "$ref": "identity-common.schema.json#/$defs/operatorId" },
        "operator_cluster_id": { "type": "string", "pattern": "^xloperator:blake3:[0-9a-f]{64}$" },
        "user_credential_id": { "$ref": "identity-common.schema.json#/$defs/userCredentialId" },
        "operator_credential_id": { "$ref": "identity-common.schema.json#/$defs/operatorCredentialId" },
        "node_credential_id": { "$ref": "identity-common.schema.json#/$defs/nodeCredentialId" },
        "credential_chain_root": { "$ref": "common.schema.json#/$defs/hash" },
        "commitment": { "$ref": "common.schema.json#/$defs/hash" },
        "committed_at": { "type": "string", "format": "date-time" },
        "signature": { "$ref": "common.schema.json#/$defs/signature" }
      },
      "required": [
        "job_id", "receipt_id", "node_id", "verified_user_id", "operator_id",
        "operator_cluster_id", "user_credential_id", "operator_credential_id",
        "node_credential_id", "credential_chain_root", "commitment", "committed_at",
        "signature"
      ]
    },
    "finalizePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "certificate_id": { "$ref": "#/$defs/certificateId" },
        "claim_id": { "$ref": "#/$defs/claimId" },
        "finalization_root": { "$ref": "common.schema.json#/$defs/hash" },
        "finalized_at": { "type": "string", "format": "date-time" },
        "signature": { "$ref": "common.schema.json#/$defs/signature" }
      },
      "required": ["certificate_id", "claim_id", "finalization_root", "finalized_at", "signature"]
    },
    "revalidatePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "certificate_id": { "$ref": "#/$defs/certificateId" },
        "claim_id": { "$ref": "#/$defs/claimId" },
        "prior_observation_receipt_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/receiptId" }
        },
        "verification_policy_id": { "$ref": "#/$defs/policyId" },
        "reason": { "type": "string", "minLength": 1 },
        "requested_at": { "type": "string", "format": "date-time" }
      },
      "required": ["certificate_id", "claim_id", "prior_observation_receipt_ids", "verification_policy_id", "reason", "requested_at"]
    },
    "claimMessage": {
      "type": "object", "additionalProperties": false,
      "properties": { "type": { "const": "XLMP_CLAIM" }, "payload": { "$ref": "#/$defs/claimPayload" } },
      "required": ["type", "payload"]
    },
    "commitMessage": {
      "type": "object", "additionalProperties": false,
      "properties": { "type": { "const": "XLMP_COMMIT" }, "payload": { "$ref": "#/$defs/commitPayload" } },
      "required": ["type", "payload"]
    },
    "computeQuoteMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_COMPUTE_QUOTE" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "quote": { "$ref": "compute-quote.schema.json" } },
          "required": ["quote"]
        }
      },
      "required": ["type", "payload"]
    },
    "proofCandidateMessage": {
      "type": "object", "additionalProperties": false,
      "properties": { "type": { "const": "XLMP_PROOF_CANDIDATE" }, "payload": { "$ref": "#/$defs/proofCandidatePayload" } },
      "required": ["type", "payload"]
    },
    "verifyRequestMessage": {
      "type": "object", "additionalProperties": false,
      "properties": { "type": { "const": "XLMP_VERIFY_REQUEST" }, "payload": { "$ref": "#/$defs/verifyRequestPayload" } },
      "required": ["type", "payload"]
    },
    "observationCommitMessage": {
      "type": "object", "additionalProperties": false,
      "properties": { "type": { "const": "XLMP_OBSERVATION_COMMIT" }, "payload": { "$ref": "#/$defs/observationCommitPayload" } },
      "required": ["type", "payload"]
    },
    "observationRevealMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_OBSERVATION_REVEAL" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "observation": { "$ref": "observation.schema.json" } },
          "required": ["observation"]
        }
      },
      "required": ["type", "payload"]
    },
    "certificateMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_CERTIFICATE" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "certificate": { "$ref": "poir-certificate.schema.json" } },
          "required": ["certificate"]
        }
      },
      "required": ["type", "payload"]
    },
    "challengeMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_CHALLENGE" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "challenge": { "$ref": "challenge.schema.json" } },
          "required": ["challenge"]
        }
      },
      "required": ["type", "payload"]
    },
    "finalizeMessage": {
      "type": "object", "additionalProperties": false,
      "properties": { "type": { "const": "XLMP_FINALIZE" }, "payload": { "$ref": "#/$defs/finalizePayload" } },
      "required": ["type", "payload"]
    },
    "revenueMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_REVENUE" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "event": { "$ref": "revenue-event.schema.json" } },
          "required": ["event"]
        }
      },
      "required": ["type", "payload"]
    },
    "revalidateMessage": {
      "type": "object", "additionalProperties": false,
      "properties": { "type": { "const": "XLMP_REVALIDATE" }, "payload": { "$ref": "#/$defs/revalidatePayload" } },
      "required": ["type", "payload"]
    },
    "nodeAdvertiseMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_NODE_ADVERTISE" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "advertisement": { "$ref": "node-service-advertisement.schema.json" } },
          "required": ["advertisement"]
        }
      },
      "required": ["type", "payload"]
    },
    "discoveryRequestMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_DISCOVERY_REQUEST" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "request": { "$ref": "node-discovery-request.schema.json" } },
          "required": ["request"]
        }
      },
      "required": ["type", "payload"]
    },
    "discoveryResponseMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_DISCOVERY_RESPONSE" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "result": { "$ref": "node-discovery-result.schema.json" } },
          "required": ["result"]
        }
      },
      "required": ["type", "payload"]
    },
    "serviceOrderMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_SERVICE_ORDER" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "order": { "$ref": "service-order.schema.json" } },
          "required": ["order"]
        }
      },
      "required": ["type", "payload"]
    },
    "serviceMatchMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_SERVICE_MATCH" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "service_match": { "$ref": "service-match.schema.json" } },
          "required": ["service_match"]
        }
      },
      "required": ["type", "payload"]
    },
    "sortitionRequestMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_SORTITION_REQUEST" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "request": { "$ref": "committee-sortition-request.schema.json" },
            "eligible_nodes": {
              "type": "array", "minItems": 1, "maxItems": 1024,
              "items": { "$ref": "eligible-node.schema.json" }
            }
          },
          "required": ["request", "eligible_nodes"]
        }
      },
      "required": ["type", "payload"]
    },
    "committeeMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_COMMITTEE" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "selection": { "$ref": "committee-selection.schema.json" } },
          "required": ["selection"]
        }
      },
      "required": ["type", "payload"]
    },
    "reputationMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_REPUTATION" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "snapshot": { "$ref": "node-reputation.schema.json" } },
          "required": ["snapshot"]
        }
      },
      "required": ["type", "payload"]
    },
    "bondMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_BOND" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "bond": { "$ref": "node-bond.schema.json" } },
          "required": ["bond"]
        }
      },
      "required": ["type", "payload"]
    },
    "userCredentialMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_USER_CREDENTIAL" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "credential": { "$ref": "user-credential.schema.json" } },
          "required": ["credential"]
        }
      },
      "required": ["type", "payload"]
    },
    "operatorCredentialMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_OPERATOR_CREDENTIAL" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "credential": { "$ref": "operator-credential.schema.json" } },
          "required": ["credential"]
        }
      },
      "required": ["type", "payload"]
    },
    "nodeCredentialMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_NODE_CREDENTIAL" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "credential": { "$ref": "node-credential.schema.json" } },
          "required": ["credential"]
        }
      },
      "required": ["type", "payload"]
    },
    "credentialRevocationMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_CREDENTIAL_REVOCATION" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "revocation": { "$ref": "credential-revocation.schema.json" } },
          "required": ["revocation"]
        }
      },
      "required": ["type", "payload"]
    },
    "sovereigntyMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_SOVEREIGNTY" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "bundle": { "$ref": "researcher-sovereignty-bundle.schema.json" } },
          "required": ["bundle"]
        }
      },
      "required": ["type", "payload"]
    },
    "portabilityMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_PORTABILITY" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "manifest": { "$ref": "researcher-portability-manifest.schema.json" } },
          "required": ["manifest"]
        }
      },
      "required": ["type", "payload"]
    },
    "residualRightMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_RESIDUAL_RIGHT" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "right": { "$ref": "researcher-residual-right.schema.json" } },
          "required": ["right"]
        }
      },
      "required": ["type", "payload"]
    },
    "economicConstitutionMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_ECONOMIC_CONSTITUTION" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "constitution": { "$ref": "economic-constitution.schema.json" } },
          "required": ["constitution"]
        }
      },
      "required": ["type", "payload"]
    },
    "economicComplianceMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_ECONOMIC_COMPLIANCE" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "constitution": { "$ref": "economic-constitution.schema.json" },
            "certificate": { "$ref": "economic-compliance-certificate.schema.json" }
          },
          "required": ["constitution", "certificate"]
        }
      },
      "required": ["type", "payload"]
    },
    "verificationProfileMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_VERIFICATION_PROFILE" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "profile": { "$ref": "verification-profile.schema.json" } },
          "required": ["profile"]
        }
      },
      "required": ["type", "payload"]
    },
    "reproductionObservationMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_REPRODUCTION_OBSERVATION" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "job": { "$ref": "verification-job.schema.json" },
            "profile": { "$ref": "verification-profile.schema.json" },
            "observation": { "$ref": "reproduction-observation.schema.json" }
          },
          "required": ["job", "profile", "observation"]
        }
      },
      "required": ["type", "payload"]
    },
    "researchCertificateMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_RESEARCH_CERTIFICATE" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "job": { "$ref": "verification-job.schema.json" },
            "profile": { "$ref": "verification-profile.schema.json" },
            "observations": { "type": "array", "minItems": 1, "items": { "$ref": "reproduction-observation.schema.json" } },
            "certificate": { "$ref": "research-verification-certificate.schema.json" }
          },
          "required": ["job", "profile", "observations", "certificate"]
        }
      },
      "required": ["type", "payload"]
    },
    "computeCooperativeMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_COMPUTE_COOPERATIVE" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "cooperative": { "$ref": "research-compute-cooperative.schema.json" } },
          "required": ["cooperative"]
        }
      },
      "required": ["type", "payload"]
    },
    "captureDashboardMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_CAPTURE_DASHBOARD" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "dashboard": { "$ref": "capture-resistance-dashboard.schema.json" } },
          "required": ["dashboard"]
        }
      },
      "required": ["type", "payload"]
    },
    "nodeWorkMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_NODE_WORK" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "receipt": { "$ref": "node-work-receipt.schema.json" } },
          "required": ["receipt"]
        }
      },
      "required": ["type", "payload"]
    },
    "nodeExposureMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_NODE_EXPOSURE" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": { "limit": { "$ref": "node-exposure-limit.schema.json" } },
          "required": ["limit"]
        }
      },
      "required": ["type", "payload"]
    },
    "misconductMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_MISCONDUCT" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "record": { "$ref": "objective-misconduct-record.schema.json" },
            "active_bond_amount": { "$ref": "common.schema.json#/$defs/amount" }
          },
          "required": ["record", "active_bond_amount"]
        }
      },
      "required": ["type", "payload"]
    },
    "governanceProposalMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_GOVERNANCE_PROPOSAL" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "proposal": { "$ref": "governance-proposal.schema.json" },
            "constitution": { "$ref": "constitutional-commitment.schema.json" },
            "fork_exit_plan": { "$ref": "fork-exit-plan.schema.json" }
          },
          "required": ["proposal", "constitution", "fork_exit_plan"]
        }
      },
      "required": ["type", "payload"]
    },
    "credentialEvidenceMessage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "const": "XLMP_CREDENTIAL_EVIDENCE" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "subject": { "$ref": "identity-common.schema.json#/$defs/verifiedUserId" },
            "policy": { "$ref": "credential-issuer-policy.schema.json" },
            "attestations": { "type": "array", "minItems": 1, "items": { "$ref": "independent-credential-attestation.schema.json" } },
            "evaluated_at": { "type": "string", "format": "date-time" }
          },
          "required": ["subject", "policy", "attestations", "evaluated_at"]
        }
      },
      "required": ["type", "payload"]
    }
  }
}
