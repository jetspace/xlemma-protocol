{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/independent-credential-attestation.schema.json",
  "title": "IndependentCredentialAttestation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "attestation_id": { "type": "string", "pattern": "^xlissuerattest:blake3:[0-9a-f]{64}$" },
    "subject": { "type": "string", "pattern": "^xluser:blake3:[0-9a-f]{64}$" },
    "issuer": { "type": "string", "minLength": 1 },
    "claims": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "credential-issuer-policy.schema.json#/$defs/claim" } },
    "qualifications": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "selective_disclosure_proof": { "type": "string", "minLength": 1 },
    "status_registry_root": { "$ref": "common.schema.json#/$defs/hash" },
    "non_revocation_proof": { "type": "string", "minLength": 1 },
    "evidence_root": { "$ref": "common.schema.json#/$defs/hash" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "issuer_signature": { "$ref": "common.schema.json#/$defs/signature" }
  },
  "required": ["attestation_id", "subject", "issuer", "claims", "qualifications", "selective_disclosure_proof", "status_registry_root", "non_revocation_proof", "evidence_root", "issued_at", "expires_at", "issuer_signature"]
}
