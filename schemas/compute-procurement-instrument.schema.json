{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlemma.example/schemas/compute-procurement-instrument.schema.json",
  "title": "ComputeProcurementInstrument",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "instrument_id": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "enum": ["spot_quote", "maximum_cost_authorization", "reserved_service_capacity", "domain_service_forward", "capacity_option"] },
    "buyer": { "type": "string", "minLength": 1 },
    "provider_id": { "type": "string", "minLength": 1 },
    "service": { "type": "string", "enum": ["research_prover_generation", "lean_build", "official_kernel_check", "independent_check", "novelty_review", "human_expert_review", "storage", "challenge_reserve"] },
    "domain": { "type": "string", "minLength": 1 },
    "service_profile_root": { "$ref": "common.schema.json#/$defs/hash" },
    "minimum_units": { "type": "integer", "minimum": 1 },
    "maximum_units": { "type": "integer", "minimum": 1 },
    "maximum_spend": { "$ref": "common.schema.json#/$defs/amount" },
    "delivery_start": { "type": "string", "format": "date-time" },
    "delivery_end": { "type": "string", "format": "date-time" },
    "exercise_deadline": { "type": ["string", "null"], "format": "date-time" },
    "reservation_or_collateral_root": { "type": ["string", "null"], "minLength": 1 },
    "settlement_policy_id": { "type": "string", "pattern": "^xlpolicy:blake3:[0-9a-f]{64}$" },
    "transferable": { "const": false },
    "signatures": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/signature" } }
  },
  "required": ["instrument_id", "stage", "buyer", "provider_id", "service", "domain", "service_profile_root", "minimum_units", "maximum_units", "maximum_spend", "delivery_start", "delivery_end", "exercise_deadline", "reservation_or_collateral_root", "settlement_policy_id", "transferable", "signatures"]
}
